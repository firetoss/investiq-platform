# InvestIQ CPU时序服务 Dockerfile - CPU专用
# 基于dustynv/pytorch镜像，使用容器自带Python环境
# 专门处理传统金融算法：ARIMA/GARCH/技术指标

FROM dustynv/pytorch:2.7-r36.4.0 AS base

WORKDIR /app

# 设置基础环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# CPU专用优化环境变量（禁用GPU）
ENV CUDA_VISIBLE_DEVICES="" \
    OMP_NUM_THREADS=12 \
    MKL_NUM_THREADS=12 \
    NUMBA_NUM_THREADS=12 \
    NUMBA_DISABLE_CUDA=1

# 算法配置环境变量
ENV ENABLE_CPU_OPTIMIZATION=true \
    ENABLE_VECTORIZATION=true \
    ALGORITHM_TYPES="arima,garch,technical_indicators"

# 安装uv包管理器
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

# 配置uv使用中科大镜像源
ENV UV_INDEX_URL="https://mirrors.ustc.edu.cn/pypi/simple" \
    UV_PROJECT_ENVIRONMENT=/usr/local/lib/python3.10/site-packages

# 创建目录结构
RUN mkdir -p /app/services /app/logs

# 复制项目配置
COPY pyproject.toml README.md ./

# 安装CPU时序分析专用依赖到容器Python环境
RUN uv add numpy scipy pandas statsmodels arch scikit-learn \
    fastapi uvicorn pydantic \
    httpx requests aiofiles \
    prometheus-client structlog loguru psutil \
    --python-preference=system

# 复制服务代码
COPY backend/app/services/cpu_timeseries_server.py /app/services/cpu_timeseries_server.py

# 验证CPU时序分析环境 - 暂时禁用以加速构建
# RUN python3 -c "import sys; import numpy, scipy, pandas, statsmodels, arch; print(f'Python: {sys.version}'); print(f'NumPy: {numpy.__version__}'); print(f'SciPy: {scipy.__version__}'); print(f'Pandas: {pandas.__version__}'); print(f'Statsmodels: {statsmodels.__version__}'); print(f'ARCH: {arch.__version__}'); print('CPU timeseries environment ready')"

# 设置权限
RUN chmod -R 755 /app

# 健康检查
HEALTHCHECK --interval=30s --timeout=30s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

# 基础启动命令
CMD ["uv", "run", "python", "/app/services/cpu_timeseries_server.py"]

# 开发阶段
FROM base AS development

# 开发环境变量
ENV LOG_LEVEL=DEBUG \
    OMP_NUM_THREADS=8

# 生产阶段  
FROM base AS production

# 创建非root用户
RUN groupadd -r timeseries && useradd -r -g timeseries -s /bin/bash timeseries

# 设置文件所有权
RUN chown -R timeseries:timeseries /app

# 切换用户
USER timeseries

# 生产环境变量
ENV LOG_LEVEL=INFO \
    OMP_NUM_THREADS=12 \
    PORT=8000