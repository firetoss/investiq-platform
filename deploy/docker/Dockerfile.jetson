# InvestIQ主应用Dockerfile - 微服务架构
# 基于dustynv/pytorch镜像，使用容器自带Python环境
# uv包管理器，AI功能通过HTTP调用独立服务

# 基础镜像 - dustynv预优化镜像
FROM dustynv/pytorch:2.7-r36.4.0 AS base

# 设置工作目录
WORKDIR /app

# 设置基础环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Jetson硬件优化环境变量
ENV NVIDIA_DRIVER_CAPABILITIES=all \
    DLA_ENABLE=1 \
    DLA_CORES=2 \
    CUDA_CACHE_DISABLE=0 \
    CUDA_CACHE_MAXSIZE=2147483648

# TensorRT优化环境变量
ENV TRT_LIBPATH=/usr/lib/aarch64-linux-gnu \
    LD_LIBRARY_PATH=${TRT_LIBPATH}:${LD_LIBRARY_PATH} \
    TRT_LOGGER_LEVEL=WARNING

# PyTorch优化环境变量
ENV TORCH_CUDNN_V8_API_ENABLED=1 \
    TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=1

# 安装uv包管理器
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

# 配置uv使用中科大镜像源
ENV UV_INDEX_URL="https://mirrors.ustc.edu.cn/pypi/simple"

# 创建项目结构
RUN mkdir -p /app/logs /app/tmp /app/data

# 复制项目配置
COPY pyproject.toml README.md ./

# 安装项目依赖到容器Python环境
# 避免创建虚拟环境，直接安装到系统Python
RUN uv sync --no-dev --python-preference=system

# 复制应用代码
COPY backend/ ./backend/
COPY data/ ./data/

# 设置权限
RUN chmod -R 755 /app/logs /app/tmp /app/data

# 验证依赖安装 - 暂时禁用以加速构建
RUN python3 -c "import sys; import fastapi, httpx, sqlalchemy, torch; print(f'Python: {sys.version}'); print(f'FastAPI: {fastapi.__version__}'); print(f'PyTorch: {torch.__version__} (GPU: {torch.cuda.is_available()})'); print('Main app dependencies verified successfully')"

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=30s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 开发阶段
FROM base AS development

# 安装开发依赖
RUN uv sync --dev --python-preference=system

# 设置开发环境变量
ENV FASTAPI_ENV=development \
    LOG_LEVEL=DEBUG

# 开发启动命令 - 使用uv run确保正确的Python环境
CMD ["uv", "run", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# 生产阶段
FROM base AS production

# 创建非root用户
RUN groupadd -r investiq && useradd -r -g investiq -s /bin/bash investiq

# 设置目录权限
RUN chown -R investiq:investiq /app

# 切换到非root用户
USER investiq

# 设置生产环境变量
ENV FASTAPI_ENV=production \
    LOG_LEVEL=INFO

# 生产启动命令 - 多进程
CMD ["uv", "run", "gunicorn", "backend.app.main:app", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--worker-connections", "1000", \
     "--max-requests", "10000", \
     "--max-requests-jitter", "1000", \
     "--preload"]